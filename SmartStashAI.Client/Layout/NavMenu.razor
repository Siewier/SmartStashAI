@inject JwtAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-truncate" href="">
            <i class="bi bi-box-seam me-2"></i>SmartStashAI
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column d-flex justify-content-between" style="min-height: calc(100vh - 3.5rem);">

        <div class="nav-links-wrapper">

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu me-2" aria-hidden="true"></span>
                    Home
                </NavLink>
            </div>

            <AuthorizeView>
                <Authorized>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="locations">
                            <span class="bi bi-folder-fill me-2" aria-hidden="true"></span>
                            Moje Schowki
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="search">
                            <span class="bi bi-search me-2" aria-hidden="true"></span>
                            Wyszukaj
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="qr-scanner">
                            <span class="bi bi-qr-code-scan me-2" aria-hidden="true"></span>
                            Skanuj Kod QR
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="ai-recognition">
                            <span class="bi bi-cpu-fill me-2" aria-hidden="true"></span>
                            Rozpoznawanie AI
                        </NavLink>
                    </div>

                </Authorized>
                <NotAuthorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="login">
                            <span class="bi bi-person-badge-fill me-2" aria-hidden="true"></span>
                            Zaloguj się
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </div>

        @* ── Panel użytkownika na dole ── *@
        <AuthorizeView>
            <Authorized>
                <div class="mt-auto p-3 border-top border-secondary bg-dark text-light border-opacity-25">
                    <div class="d-flex align-items-center mb-2">
                        <div class="bg-primary rounded-circle d-flex justify-content-center align-items-center me-2 text-white fw-bold"
                             style="width: 32px; height: 32px; min-width: 32px;">
                            @context.User.Identity?.Name?[..1].ToUpper()
                        </div>
                        <div class="text-truncate">
                            <div class="small fw-bold text-truncate">
                                @context.User.Identity?.Name
                            </div>
                            <div class="text-muted" style="font-size: 0.75rem;">
                                Gospodarstwo domowe
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-danger w-100 text-start mt-2"
                            @onclick="Logout">
                        <i class="bi bi-box-arrow-left me-2"></i> Wyloguj się
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Logout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", true);
    }
}
