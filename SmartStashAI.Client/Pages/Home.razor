@page "/"
@inject NavigationManager Navigation
@attribute [Authorize]

<AuthorizeView>
    <Authorized>
        <div class="container mt-4">
            <div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
                <div class="container-fluid py-3">
                    <h1 class="display-5 fw-bold text-primary">Cześć, @context.User.Identity?.Name!</h1>
                    <p class="col-md-8 fs-4 text-muted">Witaj w swoim inteligentnym gospodarstwie domowym (ID: @GetHouseholdId()).</p>
                    <hr class="my-4" />
                    <p>Wybierz akcję z menu, aby zarządzać pojemnikami, skanować kody QR lub zidentyfikować przedmiot przez AI.</p>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @{
            Navigation.NavigateTo("/login");
        }
    </NotAuthorized>
</AuthorizeView>

@code {
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization

    private string GetHouseholdId()
{
    // Wyciągamy zaszyte w tokenie ID domu
    return "1"; // Na potrzeby pierwszego renderu, za chwilę rozbudujemy profil
}
}