@using SmartStashAI.Shared.Dtos
@inject HttpClient Http

<div class="ms-3 my-2 border-start ps-3 border-secondary border-opacity-25">
    <div class="d-flex align-items-center justify-content-between p-2 bg-light rounded shadow-sm border mb-1">
        <div @onclick="ToggleExpand" style="cursor: pointer;" class="d-flex align-items-center flex-grow-1">
            <i class="bi @(hasChildren ? (isExpanded ? "bi-chevron-down text-primary" : "bi-chevron-right text-muted") : "bi-dot text-secondary") me-2 fs-5"></i>
            <i class="bi bi-box-seam text-warning me-2"></i>
            <span class="fw-bold text-dark">@Location.Name</span>
            <span class="badge bg-secondary ms-2 small">ID: @Location.Id</span>
        </div>

        <div class="d-flex gap-1">
            <button class="btn btn-sm btn-outline-success py-0 px-2" @onclick="() => OnAddItem.InvokeAsync(Location.Id)" title="Dodaj przedmiot do tego schowka">
                <i class="bi bi-box-arrow-in-down"></i> <span class="d-none d-sm-inline">Przedmiot</span>
            </button>

            <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => OnAddChild.InvokeAsync(Location.Id)" title="Dodaj podlokalizację">
                <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">Szuflada</span>
            </button>

            <button class="btn btn-sm btn-outline-dark py-0 px-2" @onclick="ShowQrModal" title="Pokaż kod QR">
                <i class="bi bi-qr-code"></i>
            </button>

            <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => OnDelete.InvokeAsync(Location.Id)" title="Usuń schowek">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>

    @if (Location.Items != null && Location.Items.Any() && isExpanded)
    {
        <div class="ms-4 my-1 table-responsive">
            <table class="table table-sm table-hover border rounded bg-white mb-2" style="font-size: 0.875rem;">
                <thead class="table-dark">
                    <tr>
                        <th>Nazwa przedmiotu</th>
                        <th>Kategoria</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Location.Items)
                    {
                        <tr class="@(item.IsLost ? "table-danger" : "")">
                            <td class="fw-semibold">@item.Name</td>
                            <td><span class="badge bg-info text-dark">@item.Category</span></td>
                            <td>
                                @if (item.IsLost)
                                {
                                    <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Zgubiony</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Na miejscu</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (hasChildren && isExpanded)
    {
        @foreach (var child in Location.ChildLocations)
        {
            <LocationTreeNode Location="child" OnAddChild="OnAddChild" OnShowQr="OnShowQr" OnDelete="OnDelete" OnAddItem="OnAddItem" />
        }
    }
</div>

@code {
    [Parameter] public StorageLocationResponseDto Location { get; set; } = null!;
    [Parameter] public EventCallback<int> OnAddChild { get; set; }
    [Parameter] public EventCallback<StorageLocationResponseDto> OnShowQr { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<int> OnAddItem { get; set; }

    private bool isExpanded = true;
    private bool hasChildren => Location.ChildLocations != null && Location.ChildLocations.Any();

    private void ToggleExpand() => isExpanded = !isExpanded;
    private async Task ShowQrModal() => await OnShowQr.InvokeAsync(Location);
}